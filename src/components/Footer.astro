---
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__inner">
    <span>© {year} Anthony Antonelli Andrade</span>
    <span>{lang === 'pt-br' ? 'Feito em Porto Alegre, Brasil' : 'Made in Porto Alegre, Brazil'}</span>
  </div>
</footer>
