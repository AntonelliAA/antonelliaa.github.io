---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { splitLead } from '../lib/text';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const work = [
  { name: t('backend.retro.name'), description: t('backend.retro.desc'), where: t('backend.retro.where'), stack: ['Swift', 'Vapor', 'PostgreSQL', 'WebSockets', 'OpenAPI'] },
  { name: t('backend.caronas.name'), description: t('backend.caronas.desc'), where: t('backend.caronas.where'), stack: ['PostgreSQL', 'Supabase', 'Row-level security', 'GitHub Actions'], link: 'https://github.com/AntonelliAA/Caronas' },
  { name: t('backend.gpset.name'), description: t('backend.gpset.desc'), where: t('backend.gpset.where'), stack: ['Python', 'Flask', 'SAP', 'Power BI'] },
  { name: t('backend.plugways.name'), description: t('backend.plugways.desc'), where: t('backend.plugways.where'), stack: ['PHP', 'Node.js', 'MySQL', 'AWS', 'Nginx'] },
].map((item) => ({ ...item, parts: splitLead(item.description) }));
---

<section class="backend section" id="backend" aria-labelledby="backend-title">
  <div class="container section-head">
    <p class="eyebrow">{t('backend.label')}</p>
    <h2 class="display" id="backend-title">{t('backend.title')}</h2>
    <p class="lead">{t('backend.intro')}</p>
  </div>
  <ul class="container backend__grid">
    {work.map((item) => <li class="backend__item">
      <h3>{item.name}</h3>
      <p class="backend__where">{item.where}</p>
      <p class="backend__description"><strong>{item.parts[0]}</strong> {item.parts[1]}</p>
      <p class="backend__stack">{item.stack.join(', ')}</p>
      {item.link && <a class="text-link" href={item.link} target="_blank" rel="noopener noreferrer">{t('ai.code')} <span aria-hidden="true">›</span></a>}
    </li>)}
  </ul>
</section>
