---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const groups = [
  { name: t('skills.group.apple'), items: [
    ['Swift', t('skills.ctx.swift')],
    ['SwiftUI', t('skills.ctx.swiftui')],
    ['UIKit', t('skills.ctx.uikit')],
    ['StoreKit 2', t('skills.ctx.storekit')],
    ['Core Data, SwiftData', t('skills.ctx.persistence')],
    ['MapKit', t('skills.ctx.mapkit')],
  ] },
  { name: t('skills.group.cross'), items: [
    ['Vapor', t('skills.ctx.vapor')],
    ['Node.js', t('skills.ctx.node')],
    ['PostgreSQL, MySQL', t('skills.ctx.sql')],
    ['Python', t('skills.ctx.python')],
    ['AWS', t('skills.ctx.aws')],
    ['React Native, Expo', t('skills.ctx.reactnative')],
    ['React', t('skills.ctx.react')],
  ] },
];
---

<section class="skills section" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <h2 class="title" id="skills-title">{t('skills.title')}</h2>
    <p class="skills__subtitle">{t('skills.subtitle')}</p>
    <div class="skills__columns">
      {groups.map((group) => <div>
        <h3>{group.name}</h3>
        <dl>{group.items.map((item) => <div class="skills__row"><dt>{item[0]}</dt><dd>{item[1]}</dd></div>)}</dl>
      </div>)}
    </div>
  </div>
</section>
