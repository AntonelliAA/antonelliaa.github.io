---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  description: string;
  stack: string;
  linkLabel: string;
  linkUrl?: string;
  index?: number;
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  name,
  description,
  stack,
  linkLabel,
  linkUrl = '#',
  index = 0,
  image,
  imageAlt = '',
} = Astro.props;
const stackItems = stack.split(', ');
---

<article class={`pcard reveal ${image ? '' : 'pcard--no-image'}`} style={`transition-delay: ${index * 100}ms`}>
  {image && (
    <div class="pcard__shot">
      <Image src={image} alt={imageAlt} widths={[200, 400]} sizes="150px" loading="lazy" />
    </div>
  )}

  <div class="pcard__body">
    <div class="pcard__header">
      <h3 class="pcard__name">{name}</h3>
      <a href={linkUrl} target="_blank" rel="noopener" class="pcard__link">
        {linkLabel}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>
    </div>

    <p class="pcard__desc">{description}</p>

    <div class="pcard__stack">
      {stackItems.map((item) => (
        <span class="pcard__tech">{item}</span>
      ))}
    </div>
  </div>
</article>

<style>
  .pcard {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 2rem;
    align-items: start;
    padding: 1.75rem 0;
    border-top: 1px solid var(--border);
  }

  .pcard--no-image {
    grid-template-columns: 1fr;
  }

  .pcard__shot :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
  }

  .pcard__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pcard__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .pcard__name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .pcard__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-light);
    transition: color var(--transition-fast);
    white-space: nowrap;
  }

  .pcard__link:hover {
    color: var(--accent);
  }

  .pcard__desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .pcard__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pcard__tech {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    background: var(--bg-card);
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .pcard {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .pcard__shot {
      max-width: 130px;
    }
  }
</style>
