---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="contact section" id="contact">
  <div class="container">
    <p class="kicker">{t('contact.label')}</p>
    <h2>{t('contact.title')}</h2>
    <p>{t('contact.desc')}</p>
    <a class="contact__email" href="mailto:antonellia.dev@gmail.com">antonellia.dev@gmail.com <span aria-hidden="true">↗</span></a>
    <div class="contact__links">
      <a href="https://linkedin.com/in/anthony-antonelli-andrade" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      <a href="https://github.com/AntonelliAA" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href="/resume/cv.pdf" download="Anthony_Antonelli_CV.pdf">{t('hero.cta.cv')} ↓</a>
    </div>
  </div>
</section>
