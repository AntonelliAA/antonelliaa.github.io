---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  slot: string;
  project: string;
  scene: string;
  shape: 'portrait' | 'landscape' | 'square';
  className?: string;
  priority?: boolean;
}

const { lang, slot, project, scene, shape, className, priority = false } = Astro.props;
const t = useTranslations(lang);

// Final captures in portfolio-visuals/ win; until one arrives, the App Store listing image stands in.
const storeFallback: Record<string, string> = {
  'palco-inicio': 'palco-recording',
  'palco-historico': 'palco-metrics',
  'palco-historico-diagonal': 'palco-transcript',
  'freela-empresas': 'freela-business',
  'freela-vagas': 'freela-worker',
  'rise-abertura': 'rise-title',
  'rise-jogo': 'rise-gameplay',
  'odin-lista': 'odin-orders',
  'odin-detalhes': 'odin-detail',
  'boraa-icone': 'boraa-icon',
};
const finals = import.meta.glob('../assets/portfolio-visuals/*.{png,jpg,jpeg,webp,avif}', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const store = import.meta.glob('../assets/projects/*.webp', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const byName = (files: Record<string, ImageMetadata>, name?: string) =>
  name ? Object.entries(files).find(([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === name)?.[1] : undefined;
// A localized capture (`palco-inicio.en`) wins over the shared one for that language.
const image = (lang === 'en' ? byName(finals, `${slot}.en`) : undefined) ?? byName(finals, slot) ?? byName(store, storeFallback[slot]);
const alt = `${project}: ${scene}`;
---

<div
  class:list={['project-visual', `project-visual--${shape}`, { 'project-visual--filled': !!image }, className]}
  data-asset-slot={slot}
  role={image ? undefined : 'img'}
  aria-label={image ? undefined : `${t('a11y.placeholder')} ${alt}`}
>
  {image ? (
    <Image class="project-visual__image" src={image} alt={alt} loading={priority ? 'eager' : 'lazy'} />
  ) : (
    <span class="project-visual__scene" aria-hidden="true">{scene}</span>
  )}
</div>
