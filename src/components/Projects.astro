---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import ProjectVisual from './ProjectVisual.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const other = [
  { name: t('proj.8.name'), description: t('proj.8.desc'), link: 'https://apps.apple.com/br/app/boraa/id6752790553', linkLabel: t('proj.8.link.label'), icon: true },
  { name: t('proj.4.name'), description: t('proj.4.desc'), link: 'https://tools.ages.pucrs.br/bah-plataforma-de-inova-o-de-caxias-do-sul/bah-wiki/-/wikis/home', linkLabel: t('proj.view'), icon: false },
  { name: t('proj.5.name'), description: t('proj.5.desc'), link: 'https://tools.ages.pucrs.br/ludo-pets/wiki/-/wikis/home', linkLabel: t('proj.view'), icon: false },
];
---

<section class="work" id="projects">
  <div class="container work__intro">
    <p class="kicker">{t('proj.label')}</p>
    <h2>{t('proj.title')}</h2>
    <p>{t('proj.subtitle')}</p>
  </div>

  <article class="feature feature--palco" aria-labelledby="palco-title">
    <div class="container feature__grid">
      <div class="feature__copy">
        <p class="feature__number">{t('proj.3.kind')}</p>
        <h3 id="palco-title">Palco</h3>
        <p class="feature__lead">{t('proj.3.lead')}</p>
        <p class="feature__description">{t('proj.3.desc')}</p>
        <div class="feature__process">
          <p>{t('proj.3.ai.label')}</p>
          <p>{t('proj.3.ai.desc')}</p>
        </div>
        <div class="feature__foot">
          <span>{t('proj.3.stack')}</span>
          <a class="text-link" href="https://apps.apple.com/br/app/palco-orat%C3%B3ria-e-apresenta%C3%A7%C3%A3o/id6796434989" target="_blank" rel="noopener noreferrer">{t('proj.store')} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="feature__media feature__media--palco">
        <ProjectVisual lang={lang} slot="palco-transcricao" project="Palco" scene={t('proj.3.scene.transcript')} shape="portrait" className="feature__phone feature__phone--palco-left" />
        <ProjectVisual lang={lang} slot="palco-gravacao" project="Palco" scene={t('proj.3.scene.recording')} shape="portrait" className="feature__phone feature__phone--palco-right" />
      </div>
    </div>
  </article>

  <article class="feature feature--freela" aria-labelledby="freela-title">
    <div class="container">
      <div class="feature__freela-head">
        <p class="feature__number">{t('proj.freela.kind')}</p>
        <h3 id="freela-title">Freela<br />onTap</h3>
        <p class="feature__lead">{t('proj.freela.lead')}</p>
        <p class="feature__freela-detail">{t('proj.freela.desc')}</p>
      </div>
      <div class="freela__pair">
        <div class="freela__item">
          <div class="freela__image freela__image--business"><ProjectVisual lang={lang} slot="freela-empresas" project={t('proj.6.name')} scene={t('proj.6.scene')} shape="portrait" /></div>
          <div class="freela__copy">
            <p class="freela__status">{t('proj.6.status')}</p>
            <h4>{t('proj.6.name')}</h4>
            <p>{t('proj.6.desc')}</p>
            <a class="text-link" href="https://apps.apple.com/br/app/freela-ontap-empresas/id6818285624" target="_blank" rel="noopener noreferrer">{t('proj.6.link.label')} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="freela__item">
          <div class="freela__image freela__image--worker"><ProjectVisual lang={lang} slot="freela-vagas" project={t('proj.7.name')} scene={t('proj.7.scene')} shape="portrait" /></div>
          <div class="freela__copy">
            <p class="freela__status">{t('proj.7.status')}</p>
            <h4>{t('proj.7.name')}</h4>
            <p>{t('proj.7.desc')}</p>
            <a class="text-link" href="https://apps.apple.com/br/app/freela-ontap-vagas-e-turnos/id6818288726" target="_blank" rel="noopener noreferrer">{t('proj.7.link.label')} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <article class="feature feature--rise" aria-labelledby="rise-title">
    <div class="container feature__rise-inner">
      <p class="feature__number">{t('proj.1.kind')}</p>
      <h3 id="rise-title">Rise of the<br />Lich King</h3>
      <p class="feature__lead">{t('proj.1.lead')}</p>
      <div class="feature__rise-media">
        <ProjectVisual lang={lang} slot="rise-abertura" project="Rise of the Lich King" scene={t('proj.1.scene.a')} shape="landscape" />
        <ProjectVisual lang={lang} slot="rise-jogo" project="Rise of the Lich King" scene={t('proj.1.scene.b')} shape="landscape" />
      </div>
      <div class="feature__rise-bottom">
        <p>{t('proj.1.desc')}</p>
        <a class="text-link text-link--light" href="https://apps.apple.com/br/app/rise-of-the-lich-king/id6760662821" target="_blank" rel="noopener noreferrer">{t('proj.store')} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </article>

  <article class="feature feature--odin" aria-labelledby="odin-title">
    <div class="container feature__grid feature__grid--reverse">
      <div class="feature__media feature__media--odin">
        <ProjectVisual lang={lang} slot="odin-lista" project="odinPedidos" scene={t('proj.2.scene.a')} shape="portrait" className="feature__phone feature__phone--odin-left" />
        <ProjectVisual lang={lang} slot="odin-detalhes" project="odinPedidos" scene={t('proj.2.scene.b')} shape="portrait" className="feature__phone feature__phone--odin-right" />
      </div>
      <div class="feature__copy">
        <p class="feature__number">{t('proj.2.kind')}</p>
        <h3 id="odin-title">{t('proj.2.name')}</h3>
        <p class="feature__lead">{t('proj.2.lead')}</p>
        <p class="feature__description">{t('proj.2.desc')}</p>
        <div class="feature__foot">
          <span>{t('proj.2.stack')}</span>
          <a class="text-link" href="https://apps.apple.com/br/app/odin-pedidos/id6755982771" target="_blank" rel="noopener noreferrer">{t('proj.store')} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </article>

  <div class="work__other container">
    <h3>{t('proj.academic')}</h3>
    <div class="work__other-list">
      {other.map((item) => <article>
        <div class="work__other-main">
          {item.icon && <ProjectVisual lang={lang} slot="boraa-icone" project="Boraa" scene={t('proj.8.scene')} shape="square" className="work__other-icon" />}
          <div><h4>{item.name}</h4><p>{item.description}</p></div>
        </div>
        <a class="text-link" href={item.link} target="_blank" rel="noopener noreferrer">{item.linkLabel} <span aria-hidden="true">↗</span></a>
      </article>)}
    </div>
  </div>
</section>
