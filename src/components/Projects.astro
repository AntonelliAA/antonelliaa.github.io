---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { splitLead } from '../lib/text';
import ProjectVisual from './ProjectVisual.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const [palcoHook, palcoRest] = splitLead(t('proj.3.desc'));
const [freelaHook, freelaRest] = splitLead(t('proj.freela.desc'));
const [riseHook, riseRest] = splitLead(t('proj.1.desc'));
const [odinHook, odinRest] = splitLead(t('proj.2.desc'));
const external = { target: '_blank', rel: 'noopener noreferrer' };
const freela = [
  { modifier: 'business', slot: 'freela-empresas', name: t('proj.6.name'), description: t('proj.6.desc'), status: t('proj.6.status'), scene: t('proj.6.scene'), link: 'https://apps.apple.com/br/app/freela-ontap-empresas/id6818285624' },
  { modifier: 'worker', slot: 'freela-vagas', name: t('proj.7.name'), description: t('proj.7.desc'), status: t('proj.7.status'), scene: t('proj.7.scene'), link: 'https://apps.apple.com/br/app/freela-ontap-vagas-e-turnos/id6818288726' },
];
const other = [
  { name: t('proj.8.name'), description: t('proj.8.desc'), link: 'https://apps.apple.com/br/app/boraa/id6752790553', linkLabel: t('proj.store'), icon: true },
  { name: t('proj.4.name'), description: t('proj.4.desc'), link: 'https://tools.ages.pucrs.br/bah-plataforma-de-inova-o-de-caxias-do-sul/bah-wiki/-/wikis/home', linkLabel: t('proj.view'), icon: false },
  { name: t('proj.5.name'), description: t('proj.5.desc'), link: 'https://tools.ages.pucrs.br/ludo-pets/wiki/-/wikis/home', linkLabel: t('proj.view'), icon: false },
];
---

<section class="work" id="projects" aria-labelledby="projects-title">
  <div class="container section-head">
    <p class="eyebrow">{t('proj.label')}</p>
    <h2 class="display" id="projects-title">{t('proj.title')}</h2>
    <p class="lead">{t('proj.subtitle')}</p>
  </div>

  <article class="band band--palco" id="palco" aria-labelledby="palco-title">
    <div class="container band__head">
      <h3 class="eyebrow" id="palco-title">Palco</h3>
      <p class="display">{t('proj.3.lead')}</p>
      <p class="lead"><strong>{palcoHook}</strong> {palcoRest}</p>
      <p class="band__meta">{t('proj.3.stack')}</p>
      <a class="text-link" href="https://apps.apple.com/br/app/palco-orat%C3%B3ria-e-apresenta%C3%A7%C3%A3o/id6796434989" {...external}>{t('proj.store')} <span aria-hidden="true">›</span></a>
    </div>
    <div class="phones">
      <ProjectVisual lang={lang} slot="palco-historico-diagonal" project="Palco" scene={t('proj.3.scene.history')} shape="portrait" className="phone phone--tilted" />
    </div>
  </article>

  <article class="band band--freela" aria-labelledby="freela-title">
    <div class="container band__head">
      <h3 class="eyebrow" id="freela-title">{t('proj.freela.name')}</h3>
      <p class="display">{t('proj.freela.lead')}</p>
      <p class="lead"><strong>{freelaHook}</strong> {freelaRest}</p>
    </div>
    <div class="container freela">
      {freela.map((app) => <div class="freela__item">
        <div class={`freela__frame freela__frame--${app.modifier}`}>
          <ProjectVisual lang={lang} slot={app.slot} project={app.name} scene={app.scene} shape="portrait" />
        </div>
        <p class="freela__status">{app.status}</p>
        <h4>{app.name}</h4>
        <p class="freela__description">{app.description}</p>
        <a class="text-link" href={app.link} {...external}>{t('proj.store')} <span aria-hidden="true">›</span></a>
      </div>)}
    </div>
  </article>

  <article class="band band--rise" aria-labelledby="rise-title">
    <div class="container band__head">
      <h3 class="eyebrow" id="rise-title">Rise of the Lich King</h3>
      <p class="display">{t('proj.1.lead')}</p>
      <p class="lead"><strong>{riseHook}</strong> {riseRest}</p>
      <a class="text-link" href="https://apps.apple.com/br/app/rise-of-the-lich-king/id6760662821" {...external}>{t('proj.store')} <span aria-hidden="true">›</span></a>
    </div>
    <div class="container rise">
      <ProjectVisual lang={lang} slot="rise-abertura" project="Rise of the Lich King" scene={t('proj.1.scene.a')} shape="landscape" />
      <ProjectVisual lang={lang} slot="rise-jogo" project="Rise of the Lich King" scene={t('proj.1.scene.b')} shape="landscape" />
    </div>
  </article>

  <article class="band band--odin" aria-labelledby="odin-title">
    <div class="container band__head">
      <h3 class="eyebrow" id="odin-title">{t('proj.2.name')}</h3>
      <p class="display">{t('proj.2.lead')}</p>
      <p class="lead"><strong>{odinHook}</strong> {odinRest}</p>
      <p class="band__meta">{t('proj.2.stack')}</p>
      <a class="text-link" href="https://apps.apple.com/br/app/odin-pedidos/id6755982771" {...external}>{t('proj.store')} <span aria-hidden="true">›</span></a>
    </div>
    <div class="phones">
      <ProjectVisual lang={lang} slot="odin-lista" project="odinPedidos" scene={t('proj.2.scene.a')} shape="portrait" className="phone" />
      <ProjectVisual lang={lang} slot="odin-detalhes" project="odinPedidos" scene={t('proj.2.scene.b')} shape="portrait" className="phone phone--low" />
    </div>
  </article>

  <div class="container other">
    <h3 class="other__title">{t('proj.academic')}</h3>
    <ul class="other__list">
      {other.map((item) => <li>
        {item.icon && <ProjectVisual lang={lang} slot="boraa-icone" project="Boraa" scene={t('proj.8.scene')} shape="square" className="other__icon" />}
        <div class="other__text">
          <h4>{item.name}</h4>
          <p>{item.description}</p>
          <a class="text-link" href={item.link} {...external}>{item.linkLabel} <span aria-hidden="true">›</span></a>
        </div>
      </li>)}
    </ul>
  </div>
</section>
