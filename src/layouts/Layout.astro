---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Clarity from '../components/Clarity.astro';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { title?: string; description?: string; lang?: Lang; }
const {
  title = 'Anthony Antonelli | iOS Developer and Software Engineer',
  description = 'Anthony Antonelli designs, builds and ships iPhone apps, and writes the backend behind them. Palco, Freela onTap, Rise of the Lich King, odinPedidos and Boraa.',
  lang = 'en',
} = Astro.props;
const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialFiles = import.meta.glob('../assets/portfolio-visuals/og-*.{png,jpg,jpeg,webp,avif}', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const socialName = lang === 'pt-br' ? 'og-pt' : 'og-en';
const socialImage = Object.entries(socialFiles).find(([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === socialName)?.[1];
const ogImage = socialImage ? new URL(socialImage.src, Astro.site) : undefined;
const alternates = [
  { hreflang: 'en', href: new URL('/', Astro.site) },
  { hreflang: 'pt-BR', href: new URL('/pt-br/', Astro.site) },
  { hreflang: 'x-default', href: new URL('/', Astro.site) },
];
const person = {
  '@type': 'Person',
  '@id': `${Astro.site?.href}#anthony`,
  name: 'Anthony Antonelli Andrade',
  url: Astro.site?.href,
  jobTitle: 'iOS Developer',
  email: 'antonellia.dev@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Porto Alegre', addressRegion: 'RS', addressCountry: 'BR' },
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Pontifícia Universidade Católica do Rio Grande do Sul (PUCRS)' },
  knowsAbout: ['Swift', 'SwiftUI', 'UIKit', 'iOS Development', 'Vapor', 'Node.js', 'PostgreSQL', 'Python', 'AWS', 'React Native', 'TypeScript'],
  knowsLanguage: ['pt-BR', 'en'],
  sameAs: ['https://github.com/AntonelliAA', 'https://linkedin.com/in/anthony-antonelli-andrade'],
};
// The apps that are live on the App Store today, so a search for one of them can lead back here.
const apps = [
  { name: 'Palco', url: 'https://apps.apple.com/br/app/palco-orat%C3%B3ria-e-apresenta%C3%A7%C3%A3o/id6796434989', applicationCategory: 'EducationApplication' },
  { name: 'Rise of the Lich King', url: 'https://apps.apple.com/br/app/rise-of-the-lich-king/id6760662821', applicationCategory: 'GameApplication' },
  { name: 'odinPedidos', url: 'https://apps.apple.com/br/app/odin-pedidos/id6755982771', applicationCategory: 'BusinessApplication' },
].map((app) => ({ '@type': 'SoftwareApplication', operatingSystem: 'iOS', author: { '@id': person['@id'] }, ...app }));
const schema = { '@context': 'https://schema.org', '@graph': [person, ...apps] };
---
<!doctype html>
<html lang={lang === 'pt-br' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Anthony Antonelli Andrade" />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt-br' ? 'pt_BR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'pt-br' ? 'en_US' : 'pt_BR'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {socialImage && <meta property="og:image:width" content={socialImage.width} />}
    {socialImage && <meta property="og:image:height" content={socialImage.height} />}
    {socialImage && <meta property="og:image:alt" content={t('meta.og.alt')} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="theme-color" content="#fbfbfd" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');</script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
    <Clarity />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <Header lang={lang} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <script>import '../scripts/motion.ts';</script>
  </body>
</html>
