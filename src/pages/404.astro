---
import Layout from '../layouts/Layout.astro';

// GitHub Pages serves a single 404.html for every locale, so this page says it
// in both rather than guessing.
---

<Layout
  lang="en"
  title="Page not found — Anthony Antonelli"
  description="That page does not exist."
>
  <section class="section notfound">
    <div class="container">
      <p class="section-label">404</p>
      <h1 class="notfound__title">This page doesn't exist</h1>
      <p class="notfound__text">
        The link may be out of date, or the address mistyped.
      </p>
      <p class="notfound__text notfound__text--alt" lang="pt-BR">
        Essa página não existe. O link pode estar desatualizado, ou o endereço
        foi digitado errado.
      </p>

      <div class="notfound__ctas">
        <a href="/" class="btn btn-primary">Back to the portfolio</a>
        <a href="/pt-br/" class="btn btn-secondary" lang="pt-BR">Ver em português</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .notfound {
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding-top: 6rem;
  }

  .notfound__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .notfound__text {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 46ch;
    margin-bottom: 0.5rem;
  }

  .notfound__text--alt {
    margin-bottom: 2rem;
  }

  .notfound__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
