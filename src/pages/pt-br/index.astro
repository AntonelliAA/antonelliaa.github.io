---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Experience from '../../components/Experience.astro';
import Projects from '../../components/Projects.astro';
import BuiltWithAgents from '../../components/BuiltWithAgents.astro';
import Skills from '../../components/Skills.astro';
import Education from '../../components/Education.astro';
import Contact from '../../components/Contact.astro';

const lang = 'pt-br' as const;
---

<Layout
  lang={lang}
  title="Anthony Antonelli — Desenvolvedor iOS & Engenheiro de Software"
  description="Anthony Antonelli desenha, desenvolve e publica apps para iPhone. Conheça Palco, os dois apps Freela onTap, Rise of the Lich King, odinPedidos e Boraa."
>
  <Hero lang={lang} />
  <Projects lang={lang} />
  <BuiltWithAgents lang={lang} />
  <About lang={lang} />
  <Experience lang={lang} />
  <Skills lang={lang} />
  <Education lang={lang} />
  <Contact lang={lang} />
</Layout>
